# Ansible runs on the bastion (control node). Copy this file to inventory.ini.
# Private IPs: `terraform output private_ips` in terraform-v2.
# Keys reach the private hosts through agent forwarding (ssh -A); no key is stored on the bastion.

[bastion_host]
bastion ansible_connection=local

[private]
app-server     ansible_host=APP_PRIVATE_IP
git-server     ansible_host=GIT_PRIVATE_IP
jenkins-server ansible_host=JENKINS_PRIVATE_IP

[all:vars]
ansible_user=ubuntu
ansible_python_interpreter=/usr/bin/python3